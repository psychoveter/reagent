{
  "agentName": "BrowserAgent",
  "lang": "ts",
  "plays": [
    {
      "protocolName": "CrossLangDemo",
      "roleName": "browser"
    }
  ],
  "initAction": {
    "body": "\n    $self.ready = true\n    $self.responsesReceived = 0\n  ",
    "lang": "ts"
  },
  "lifecycleHandlers": [
    {
      "event": "protocolCompleted",
      "protocolFilter": "CrossLangDemo",
      "action": {
        "body": "\n    $self.responsesReceived += 1\n  ",
        "lang": "ts"
      }
    }
  ]
}
