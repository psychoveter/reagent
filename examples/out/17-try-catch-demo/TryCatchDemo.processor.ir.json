      "id": "recv_10",
      "kind": "receive",
      "data": {
        "kind": "receive",
        "from": "sender",
        "arrow": "-->",
        "messageName": "Request",
        "postReceiveZone": "\n      $ctx.requestText = $ctx.msg.text\n    ",
        "propagateFlow": true
      }
    },
    {
      "id": "act_11",
      "kind": "action",
      "data": {
        "kind": "action",
        "body": "\n      if ($ctx.requestText === \"fail\") {\n        throw new Error(\"processing_failed\")\n      }\n      $ctx.result = \"processed:\" + $ctx.requestText\n    ",
        "lang": "ts"
      }
    },
    {
      "id": "send_12",
      "kind": "send",
      "data": {
        "kind": "send",
        "to": "sender",
        "arrow": "-->",
        "messageName": "Result",
        "preSendZone": "\n        $ctx.msg.data = $ctx.result\n      ",
        "propagateFlow": true
      }
    },
    {
      "id": "catch_14",
      "kind": "error",
      "data": {
        "kind": "error",
        "label": "error"
      }
    },
    {
      "id": "act_15",
      "kind": "action",
      "data": {
        "kind": "action",
        "body": "\n      $ctx.errorMsg = \"error occurred\"\n    ",
        "lang": "ts"
      }
    },
    {
      "id": "send_16",
      "kind": "send",
      "data": {
        "kind": "send",
        "to": "sender",
        "arrow": "-->",
        "messageName": "Failure",
        "preSendZone": "\n        $ctx.msg.reason = $ctx.errorMsg\n      ",
        "propagateFlow": true
      }
    },
    {
      "id": "try_merge_13",
      "kind": "guard",
      "data": {
        "kind": "guard",
        "guardType": "expression"
      }
    },
    {
      "id": "end_17",
      "kind": "terminal",
      "data": {
        "kind": "terminal",
        "status": "completed"
      }
    }
