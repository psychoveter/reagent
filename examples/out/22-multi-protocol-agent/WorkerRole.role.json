{
  "roleName": "WorkerRole",
  "lang": "ts",
  "plays": [
    {
      "protocolName": "TaskProcessing",
      "roleName": "worker"
    },
    {
      "protocolName": "HealthCheck",
      "roleName": "worker"
    }
  ],
  "initAction": {
    "body": "\n    $self.tasksProcessed = 0\n    $self.healthChecks = 0\n  ",
    "lang": "ts"
  },
  "lifecycleHandlers": [
    {
      "event": "protocolCompleted",
      "protocolFilter": "TaskProcessing",
      "action": {
        "body": "\n    $self.taskCompletions = ($self.taskCompletions || 0) + 1\n  ",
        "lang": "ts"
      }
    },
    {
      "event": "protocolCompleted",
      "protocolFilter": "HealthCheck",
      "action": {
        "body": "\n    $self.healthCompletions = ($self.healthCompletions || 0) + 1\n  ",
        "lang": "ts"
      }
    }
  ]
}
