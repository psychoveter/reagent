{
  "roleName": "MonitorRole",
  "lang": "ts",
  "plays": [
    {
      "protocolName": "HealthCheck",
      "roleName": "monitor"
    }
  ],
  "initAction": {
    "body": " $self.pongCount = 0 ",
    "lang": "ts"
  },
  "lifecycleHandlers": [
    {
      "event": "protocolCompleted",
      "protocolFilter": "HealthCheck",
      "action": {
        "body": "\n    $self.pongCount = ($self.pongCount || 0) + 1\n  ",
        "lang": "ts"
      }
    }
  ]
}
