{
  "kind": "claude_live_agent_node",
  "runtime": {
    "nodeId": "human-gate",
    "langs": ["ts"],
    "stateStore": {
      "kind": "etcd",
      "hosts": ["http://127.0.0.1:2379"]
    },
    "membership": {
      "enabled": true
    },
    "messagePlane": {
      "kind": "nats",
      "url": "nats://localhost:4222"
    },
    "telemetry": {
      "traceSink": "none",
      "interceptors": []
    },
    "controlEndpoint": {
      "enabled": true,
      "host": "127.0.0.1",
      "port": 19091,
      "advertiseUrl": "ws://127.0.0.1:19091"
    },
    "triggerPolicies": {},
    "cronIntervalMs": 15000
  },
  "agent": {
    "name": "HumanAgent",
    "roles": ["HumanRole"]
  },
  "claude": {
    "tools": [],
    "mcpServers": {},
    "maxTurns": 4,
    "permissionMode": "bypassPermissions",
    "extraInstructions": "You are the delegating side. Prepare clean task briefs, and when reviewing a worker result, set review.accepted to true if the answer is coherent and useful."
  }
}
