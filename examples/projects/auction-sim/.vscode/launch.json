{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Auction Node",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "${workspaceFolder}/../../../runtime/ts/node_modules/.bin/tsx",
      "program": "${workspaceFolder}/run_node.ts",
