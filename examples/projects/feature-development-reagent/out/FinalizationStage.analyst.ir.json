{
  "protocolName": "FinalizationStage",
  "role": "analyst",
  "lang": "ts",
  "states": [
    {
      "id": "init_13",
      "kind": "initial",
      "data": {
        "kind": "initial"
      }
    },
    {
      "id": "recv_14",
      "kind": "receive",
      "data": {
        "kind": "receive",
        "from": "human",
        "arrow": "-->",
        "messageName": "StageInput",
        "postReceiveZone": "\n      $ctx.task = $ctx.msg.task\n      $ctx.previous = $ctx.msg.previous\n      $ctx.iteration = 0\n      $ctx.stageApproved = false\n      $ctx.pendingChanges = null\n    "
      }
    },
    {
      "id": "loop_guard_15",
      "kind": "guard",
      "data": {
        "kind": "guard",
        "guardType": "expression",
        "expr": "$ctx.stageApproved != true"
      }
    },
    {
      "id": "act_17",
      "kind": "action",
      "data": {
        "kind": "action",
        "body": "\n      $ctx.iteration = $ctx.iteration + 1\n      $ctx.finalDraft = {\n        stage: \"finalization\",\n        docUpdates: {\n          product: \"updated product docs for \" + $ctx.task.title,\n          user: \"updated user guide\",\n          spec: \"updated implementation and acceptance notes\"\n        },\n        backlogUpdates: {\n          closed: [\"implementation task\"],\n          followUps: [\"future improvements\", \"deferred work\"]\n        },\n        releaseNotes: {\n          summary: \"feature finalized\",\n          revision: $ctx.iteration\n        },\n        revisionNote: $ctx.pendingChanges\n      }\n    ",
        "lang": "ts"
      }
    },
    {
      "id": "send_18",
      "kind": "send",
      "data": {
        "kind": "send",
        "to": "developer",
        "arrow": "-->",
        "messageName": "FinalizationPacket",
        "preSendZone": "\n        $ctx.msg.stage = $ctx.finalDraft.stage\n        $ctx.msg.docUpdates = $ctx.finalDraft.docUpdates\n        $ctx.msg.backlogUpdates = $ctx.finalDraft.backlogUpdates\n        $ctx.msg.releaseNotes = $ctx.finalDraft.releaseNotes\n        $ctx.msg.revisionNote = $ctx.finalDraft.revisionNote\n      "
      }
    },
    {
      "id": "recv_19",
      "kind": "receive",
      "data": {
        "kind": "receive",
        "from": "reviewer",
        "arrow": "-->",
        "messageName": "ReviewFeedback",
        "postReceiveZone": "\n        $ctx.reviewFeedback = $ctx.msg\n      "
      }
    },
    {
      "id": "send_20",
      "kind": "send",
      "data": {
        "kind": "send",
        "to": "human",
        "arrow": "-->",
        "messageName": "ApprovalRequest",
        "preSendZone": "\n        $ctx.msg.stage = \"finalization\"\n        $ctx.msg.artifact = $ctx.finalPacket\n        $ctx.msg.review = $ctx.reviewFeedback\n      "
      }
    },
    {
      "id": "recv_21",
      "kind": "receive",
      "data": {
        "kind": "receive",
        "from": "human",
        "arrow": "-->",
        "messageName": "ApprovalDecision",
        "postReceiveZone": "\n        $ctx.stageApproved = $ctx.msg.approved\n        $ctx.pendingChanges = $ctx.msg.requestedChanges\n        $ctx.lastDecision = $ctx.msg\n      "
      }
    },
    {
      "id": "xor_22",
      "kind": "guard",
      "data": {
        "kind": "guard",
        "guardType": "xor",
        "decisionRole": "analyst"
      }
    },
    {
      "id": "guard_24",
      "kind": "guard",
      "data": {
        "kind": "guard",
        "guardType": "expression",
        "expr": "$ctx.stageApproved == true"
      }
    },
    {
      "id": "act_25",
      "kind": "action",
      "data": {
        "kind": "action",
        "body": "\n        reagent.return({\n          stage: \"finalization\",\n          status: \"approved\",\n          artifact: $ctx.finalPacket,\n          humanDecision: $ctx.lastDecision\n        })\n      ",
        "lang": "ts"
      }
    },
    {
      "id": "else_26",
      "kind": "guard",
      "data": {
        "kind": "guard",
        "guardType": "expression"
      }
    },
    {
      "id": "act_27",
      "kind": "action",
      "data": {
        "kind": "action",
        "body": "\n        $ctx.pendingChanges = $ctx.lastDecision.requestedChanges\n      ",
        "lang": "ts"
      }
    },
    {
      "id": "merge_23",
      "kind": "guard",
      "data": {
        "kind": "guard",
        "guardType": "expression"
      }
    },
    {
      "id": "loop_exit_16",
      "kind": "guard",
      "data": {
        "kind": "guard",
        "guardType": "expression"
      }
    },
    {
      "id": "end_28",
      "kind": "terminal",
      "data": {
        "kind": "terminal",
        "status": "completed"
      }
    }
  ],
