  "states": [
    {
      "id": "init_13",
      "kind": "initial",
      "data": {
        "kind": "initial"
      }
    },
    {
      "id": "loop_guard_14",
      "kind": "guard",
      "data": {
        "kind": "guard",
        "guardType": "expression",
        "expr": "$ctx.stageApproved != true"
      }
    },
    {
      "id": "recv_16",
      "kind": "receive",
      "data": {
        "kind": "receive",
        "from": "reviewer",
        "arrow": "-->",
        "messageName": "ReviewFeedback",
        "postReceiveZone": "\n        $ctx.reviewFeedback = $ctx.msg\n      "
      }
    },
    {
      "id": "act_17",
      "kind": "action",
      "data": {
        "kind": "action",
        "body": "\n      $ctx.implSummary = {\n        stage: \"implementation\",\n        changeSet: $ctx.reviewTarget.changeSet,\n        tests: $ctx.reviewTarget.tests,\n        architectureNotes: $ctx.reviewTarget.architectureNotes,\n        revisionNote: $ctx.reviewFeedback.requestedChanges\n      }\n    ",
        "lang": "ts"
      }
    },
    {
      "id": "send_18",
      "kind": "send",
      "data": {
        "kind": "send",
        "to": "human",
        "arrow": "-->",
        "messageName": "ApprovalRequest",
        "preSendZone": "\n        $ctx.msg.stage = \"implementation\"\n        $ctx.msg.artifact = $ctx.implSummary\n        $ctx.msg.review = $ctx.reviewFeedback\n      "
      }
    },
    {
      "id": "recv_19",
      "kind": "receive",
      "data": {
        "kind": "receive",
        "from": "human",
        "arrow": "-->",
        "messageName": "ApprovalDecision",
        "postReceiveZone": "\n        $ctx.stageApproved = $ctx.msg.approved\n        $ctx.pendingChanges = $ctx.msg.requestedChanges\n        $ctx.lastDecision = $ctx.msg\n      "
      }
    },
    {
      "id": "xor_20",
      "kind": "guard",
      "data": {
        "kind": "guard",
        "guardType": "xor"
      }
    },
    {
      "id": "guard_22",
      "kind": "guard",
      "data": {
        "kind": "guard",
        "guardType": "expression",
        "expr": "$ctx.stageApproved == true"
      }
    },
    {
      "id": "act_23",
      "kind": "action",
      "data": {
        "kind": "action",
        "body": "\n        reagent.return({\n          stage: \"implementation\",\n          status: \"approved\",\n          artifact: $ctx.implSummary,\n          humanDecision: $ctx.lastDecision\n        })\n      ",
        "lang": "ts"
      }
    },
    {
      "id": "else_24",
      "kind": "guard",
      "data": {
        "kind": "guard",
        "guardType": "expression"
      }
    },
    {
      "id": "merge_21",
      "kind": "guard",
      "data": {
        "kind": "guard",
        "guardType": "expression"
      }
    },
    {
      "id": "loop_exit_15",
