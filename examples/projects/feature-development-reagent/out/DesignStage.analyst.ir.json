{
  "protocolName": "DesignStage",
  "role": "analyst",
  "lang": "ts",
  "states": [
    {
      "id": "init_13",
      "kind": "initial",
      "data": {
        "kind": "initial"
      }
    },
    {
      "id": "recv_14",
      "kind": "receive",
      "data": {
        "kind": "receive",
        "from": "human",
        "arrow": "-->",
        "messageName": "FeatureTask",
        "postReceiveZone": "\n      $ctx.task = $ctx.msg\n      $ctx.iteration = 0\n      $ctx.stageApproved = false\n      $ctx.pendingChanges = null\n    "
      }
    },
    {
      "id": "loop_guard_15",
      "kind": "guard",
      "data": {
        "kind": "guard",
        "guardType": "expression",
        "expr": "$ctx.stageApproved != true"
      }
    },
    {
      "id": "act_17",
      "kind": "action",
      "data": {
        "kind": "action",
        "body": "\n      $ctx.iteration = $ctx.iteration + 1\n      $ctx.designDraft = {\n        stage: \"design\",\n        docsDelta: {\n          product: \"updated problem statement for \" + $ctx.task.title,\n          user: \"updated user-facing behavior notes\",\n          spec: \"updated technical spec revision \" + $ctx.iteration\n        },\n        architecture: {\n          components: [\"protocol\", \"roles\", \"tooling\"],\n          decision: \"analyst formalized the problem and prepared design input\"\n        },\n        openQuestions: [],\n        revisionNote: $ctx.pendingChanges\n      }\n    ",
        "lang": "ts"
      }
    },
    {
      "id": "send_18",
      "kind": "send",
      "data": {
        "kind": "send",
        "to": "developer",
        "arrow": "-->",
        "messageName": "DesignPacket",
        "preSendZone": "\n        $ctx.msg.stage = $ctx.designDraft.stage\n        $ctx.msg.docsDelta = $ctx.designDraft.docsDelta\n        $ctx.msg.architecture = $ctx.designDraft.architecture\n        $ctx.msg.openQuestions = $ctx.designDraft.openQuestions\n        $ctx.msg.revisionNote = $ctx.designDraft.revisionNote\n      "
      }
    },
    {
      "id": "recv_19",
      "kind": "receive",
      "data": {
        "kind": "receive",
        "from": "reviewer",
        "arrow": "-->",
        "messageName": "ReviewFeedback",
        "postReceiveZone": "\n        $ctx.reviewFeedback = $ctx.msg\n      "
      }
    },
    {
      "id": "send_20",
      "kind": "send",
      "data": {
        "kind": "send",
        "to": "human",
        "arrow": "-->",
        "messageName": "ApprovalRequest",
        "preSendZone": "\n        $ctx.msg.stage = \"design\"\n        $ctx.msg.artifact = $ctx.designProposal\n        $ctx.msg.review = $ctx.reviewFeedback\n      "
      }
    },
    {
      "id": "recv_21",
      "kind": "receive",
      "data": {
        "kind": "receive",
        "from": "human",
        "arrow": "-->",
        "messageName": "ApprovalDecision",
        "postReceiveZone": "\n        $ctx.stageApproved = $ctx.msg.approved\n        $ctx.pendingChanges = $ctx.msg.requestedChanges\n        $ctx.lastDecision = $ctx.msg\n      "
      }
    },
    {
      "id": "xor_22",
      "kind": "guard",
      "data": {
        "kind": "guard",
        "guardType": "xor",
        "decisionRole": "analyst"
      }
    },
    {
      "id": "guard_24",
      "kind": "guard",
      "data": {
        "kind": "guard",
        "guardType": "expression",
        "expr": "$ctx.stageApproved == true"
      }
    },
    {
      "id": "act_25",
      "kind": "action",
      "data": {
        "kind": "action",
        "body": "\n        reagent.return({\n          stage: \"design\",\n          status: \"approved\",\n          artifact: $ctx.designProposal,\n          humanDecision: $ctx.lastDecision\n        })\n      ",
        "lang": "ts"
      }
    },
    {
      "id": "else_26",
      "kind": "guard",
      "data": {
        "kind": "guard",
        "guardType": "expression"
      }
    },
    {
      "id": "act_27",
      "kind": "action",
      "data": {
        "kind": "action",
        "body": "\n        $ctx.pendingChanges = $ctx.lastDecision.requestedChanges\n      ",
        "lang": "ts"
      }
    },
    {
      "id": "merge_23",
      "kind": "guard",
      "data": {
        "kind": "guard",
        "guardType": "expression"
      }
    },
    {
      "id": "loop_exit_16",
      "kind": "guard",
      "data": {
        "kind": "guard",
        "guardType": "expression"
      }
    },
    {
      "id": "end_28",
      "kind": "terminal",
      "data": {
        "kind": "terminal",
        "status": "completed"
      }
    }
  ],
