{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psychoveter.github.io/reagent/schemas/lang/ast.v0.0.4.json",
  "title": "Reagent Language AST (v0.0.4)",
  "description": "Full AST for the Reagent protocol language, covering all constructs from lang-spec v0.0.4.",
  "type": "object",
  "required": ["kind", "items"],
  "properties": {
    "kind": { "const": "Program" },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/TopLevelItem" }
    }
  },
  "$defs": {
    "Loc": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": { "$ref": "#/$defs/Pos" },
        "end": { "$ref": "#/$defs/Pos" }
      },
      "additionalProperties": false
    },
    "Pos": {
      "type": "object",
      "required": ["index", "line", "col"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "line": { "type": "integer", "minimum": 1 },
        "col": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "TopLevelItem": {
      "oneOf": [
        { "$ref": "#/$defs/ImportStmt" },
        { "$ref": "#/$defs/ProtocolDef" }
      ]
    },
    "ImportStmt": {
      "type": "object",
      "required": ["kind", "path", "loc"],
      "properties": {
        "kind": { "const": "ImportStmt" },
        "path": { "type": "string", "minLength": 1 },
        "alias": { "type": "string" },
        "loc": { "$ref": "#/$defs/Loc" }
      },
      "additionalProperties": false
    },
    "ProtocolDef": {
      "type": "object",
      "required": ["kind", "name", "participants", "initiator", "input", "body", "loc"],
      "properties": {
        "kind": { "const": "ProtocolDef" },
        "name": { "type": "string", "minLength": 1 },
        "participants": { "type": "array", "items": { "$ref": "#/$defs/ParticipantDecl" } },
        "initiator": { "type": "string" },
        "input": { "type": "string" },
        "body": { "type": "array", "items": { "$ref": "#/$defs/ProtocolItem" } },
        "loc": { "$ref": "#/$defs/Loc" }
      },
      "additionalProperties": false
    },
    "ParticipantDecl": {
      "type": "object",
      "required": ["kind", "name", "lang", "loc"],
      "properties": {
        "kind": { "const": "ParticipantDecl" },
        "name": { "type": "string", "minLength": 1 },
        "lang": { "enum": ["ts", "js", "py", "kt"] },
        "loc": { "$ref": "#/$defs/Loc" }
      },
      "additionalProperties": false
    },
    "ProtocolItem": {
      "oneOf": [
        { "$ref": "#/$defs/MessageStmt" },
        { "$ref": "#/$defs/AgentZone" },
        { "$ref": "#/$defs/AltStmt" },
        { "$ref": "#/$defs/LoopStmt" },
        { "$ref": "#/$defs/ParStmt" },
        { "$ref": "#/$defs/WaitStmt" },
        { "$ref": "#/$defs/TryStmt" }
      ]
    },
    "MessageStmt": {
      "type": "object",
      "required": ["kind", "from", "arrow", "to", "messageName", "loc"],
      "properties": {
        "kind": { "const": "MessageStmt" },
        "from": { "type": "string", "minLength": 1 },
        "arrow": { "enum": ["-->", "->", "->>", "-->>"] },
        "to": { "type": "string", "minLength": 1 },
        "messageName": { "type": "string", "minLength": 1 },
        "props": { "$ref": "#/$defs/MessageProps" },
        "loc": { "$ref": "#/$defs/Loc" }
      },
      "additionalProperties": false
    },
    "MessageProps": {
      "type": "object",
      "required": ["kind", "hooks", "pairs", "loc"],
      "properties": {
        "kind": { "const": "MessageProps" },
        "hooks": { "type": "array", "items": { "$ref": "#/$defs/HookZone" } },
        "pairs": { "type": "array", "items": { "$ref": "#/$defs/PropPair" } },
        "loc": { "$ref": "#/$defs/Loc" }
      },
      "additionalProperties": false
    },
    "HookZone": {
      "type": "object",
      "required": ["kind", "hookType", "body", "loc"],
      "properties": {
        "kind": { "const": "HookZone" },
        "hookType": { "enum": ["onSend", "onReceive"] },
        "body": { "type": "string" },
        "loc": { "$ref": "#/$defs/Loc" }
      },
      "additionalProperties": false
    },
    "PropPair": {
      "type": "object",
      "required": ["kind", "key", "value", "loc"],
      "properties": {
        "kind": { "const": "PropPair" },
        "key": { "type": "string" },
        "value": { "type": "string" },
        "loc": { "$ref": "#/$defs/Loc" }
      },
      "additionalProperties": false
    },
    "AgentZone": {
      "type": "object",
      "required": ["kind", "agent", "lang", "body", "loc"],
      "properties": {
        "kind": { "const": "AgentZone" },
        "agent": { "type": "string", "minLength": 1 },
        "lang": { "enum": ["ts", "js", "py", "kt"] },
        "body": { "type": "string" },
        "loc": { "$ref": "#/$defs/Loc" }
      },
      "additionalProperties": false
    },
    "AltStmt": {
      "type": "object",
      "required": ["kind", "branches", "loc"],
      "properties": {
        "kind": { "const": "AltStmt" },
        "branches": { "type": "array", "items": { "$ref": "#/$defs/AltBranch" } },
        "loc": { "$ref": "#/$defs/Loc" }
      },
      "additionalProperties": false
    },
    "AltBranch": {
      "type": "object",
      "required": ["kind", "guard", "body", "loc"],
      "properties": {
        "kind": { "const": "AltBranch" },
        "guard": { "$ref": "#/$defs/AltGuard" },
        "body": { "type": "array", "items": { "$ref": "#/$defs/ProtocolItem" } },
        "loc": { "$ref": "#/$defs/Loc" }
      },
      "additionalProperties": false
    },
    "AltGuard": {
      "oneOf": [
        { "$ref": "#/$defs/AltMessageGuard" },
        { "$ref": "#/$defs/AltExprGuard" },
        { "$ref": "#/$defs/AltTimeoutGuard" },
        { "$ref": "#/$defs/AltElseGuard" }
      ]
    },
    "AltMessageGuard": {
      "type": "object",
      "required": ["kind", "from", "arrow", "to", "messageName", "loc"],
      "properties": {
        "kind": { "const": "AltMessageGuard" },
        "from": { "type": "string" },
        "arrow": { "enum": ["-->", "->", "->>", "-->>"] },
        "to": { "type": "string" },
        "messageName": { "type": "string" },
        "props": { "$ref": "#/$defs/MessageProps" },
        "loc": { "$ref": "#/$defs/Loc" }
      },
      "additionalProperties": false
    },
    "AltExprGuard": {
      "type": "object",
      "required": ["kind", "expr", "loc"],
      "properties": {
        "kind": { "const": "AltExprGuard" },
        "expr": { "type": "string" },
        "loc": { "$ref": "#/$defs/Loc" }
      },
      "additionalProperties": false
    },
    "AltTimeoutGuard": {
      "type": "object",
      "required": ["kind", "duration", "loc"],
      "properties": {
        "kind": { "const": "AltTimeoutGuard" },
        "duration": { "$ref": "#/$defs/Duration" },
        "loc": { "$ref": "#/$defs/Loc" }
      },
      "additionalProperties": false
    },
    "AltElseGuard": {
      "type": "object",
      "required": ["kind", "loc"],
      "properties": {
        "kind": { "const": "AltElseGuard" },
        "loc": { "$ref": "#/$defs/Loc" }
      },
      "additionalProperties": false
    },
    "LoopStmt": {
      "type": "object",
      "required": ["kind", "guard", "body", "loc"],
      "properties": {
        "kind": { "const": "LoopStmt" },
        "guard": { "type": "string" },
        "body": { "type": "array", "items": { "$ref": "#/$defs/ProtocolItem" } },
        "loc": { "$ref": "#/$defs/Loc" }
      },
      "additionalProperties": false
    },
    "ParStmt": {
      "type": "object",
      "required": ["kind", "branches", "loc"],
      "properties": {
        "kind": { "const": "ParStmt" },
        "branches": { "type": "array", "items": { "$ref": "#/$defs/ParBranch" } },
        "loc": { "$ref": "#/$defs/Loc" }
      },
      "additionalProperties": false
    },
    "ParBranch": {
      "type": "object",
      "required": ["kind", "body", "loc"],
      "properties": {
        "kind": { "const": "ParBranch" },
        "body": { "type": "array", "items": { "$ref": "#/$defs/ProtocolItem" } },
        "loc": { "$ref": "#/$defs/Loc" }
      },
      "additionalProperties": false
    },
    "WaitStmt": {
      "type": "object",
      "required": ["kind", "duration", "loc"],
      "properties": {
        "kind": { "const": "WaitStmt" },
        "duration": { "$ref": "#/$defs/Duration" },
        "loc": { "$ref": "#/$defs/Loc" }
      },
      "additionalProperties": false
    },
    "Duration": {
      "type": "object",
      "required": ["value", "unit", "loc"],
      "properties": {
        "value": { "type": "number" },
        "unit": { "enum": ["ms", "s", "m", "h"] },
        "loc": { "$ref": "#/$defs/Loc" }
      },
      "additionalProperties": false
    },
    "TryStmt": {
      "type": "object",
      "required": ["kind", "tryBody", "catchLabel", "catchBody", "loc"],
      "properties": {
        "kind": { "const": "TryStmt" },
        "tryBody": { "type": "array", "items": { "$ref": "#/$defs/ProtocolItem" } },
        "catchLabel": { "type": "string" },
        "catchBody": { "type": "array", "items": { "$ref": "#/$defs/ProtocolItem" } },
        "loc": { "$ref": "#/$defs/Loc" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
