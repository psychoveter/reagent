{
  "name": "reagent-vscode",
  "displayName": "Reagent Language Support",
  "description": "Language support for Reagent protocol DSL (.rg) with embedded language intelligence in agent zones.",
  "version": "0.0.9",
  "publisher": "psychoveter",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:reagent"
  ],
  "contributes": {
    "languages": [
      {
        "id": "reagent",
        "aliases": [
          "Reagent",
          "reagent"
        ],
        "extensions": [
          ".rg"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/reagent-light.svg",
          "dark": "./icons/reagent-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "reagent",
        "scopeName": "source.reagent",
        "path": "./syntaxes/reagent.tmLanguage.json"
      }
    ],
    "breakpoints": [
      {
        "language": "reagent"
      }
    ],
    "debuggers": [
      {
        "type": "reagent",
        "label": "Reagent Debug",
        "languages": [
          "reagent"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "rgFile"
            ],
            "properties": {
              "rgFile": {
                "type": "string",
                "description": "Path to the .rg file to debug"
              },
              "rosPort": {
                "type": "number",
                "default": 18789,
                "description": "Port of the Reagent Orchestrator Service"
              },
              "rosHost": {
                "type": "string",
                "default": "127.0.0.1",
                "description": "Host of the Reagent Orchestrator Service"
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "reagent",
            "request": "launch",
            "name": "Debug Reagent Protocol",
            "rgFile": "${file}",
            "rosPort": 18789
          }
        ],
        "configurationSnippets": [
          {
            "label": "Reagent: Debug Protocol",
            "description": "Debug a Reagent protocol via ROS",
            "body": {
              "type": "reagent",
              "request": "launch",
              "name": "Debug Reagent Protocol",
              "rgFile": "^\"\\${file}\"",
              "rosPort": 18789
            }
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "reagent.run",
        "title": "Reagent: Run Protocol",
        "icon": "$(play)"
      },
      {
        "command": "reagent.startDebug",
        "title": "Reagent: Start Debug Session",
        "icon": "$(debug-alt)"
      },
      {
        "command": "reagent.showTraceTimeline",
        "title": "Reagent: Show Trace Timeline"
      },
      {
        "command": "reagent.inspectAgent",
        "title": "Reagent: Inspect Agent State"
      },
      {
        "command": "reagent.openDiagram",
        "title": "Reagent: Open Protocol Diagram",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "reagent.openProjectDiagram",
        "title": "Reagent: Open Project Overview",
        "icon": "$(graph)"
      },
      {
        "command": "reagent.startRos",
        "title": "Reagent: Start ROS"
      },
      {
        "command": "reagent.stopRos",
        "title": "Reagent: Stop ROS"
      },
      {
        "command": "reagent.toggleRos",
        "title": "Reagent: Toggle ROS"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "reagent.openProjectDiagram",
          "when": "resourceLangId == reagent",
          "group": "navigation"
        },
        {
          "command": "reagent.openDiagram",
          "when": "resourceLangId == reagent",
          "group": "navigation"
        },
        {
          "command": "reagent.run",
          "when": "resourceLangId == reagent",
          "group": "navigation"
        }
      ]
    },
    "views": {
      "debug": [
        {
          "id": "reagentDebugPanel",
          "name": "Reagent Debug",
          "when": "debugType == 'reagent'"
        }
      ]
    }
  },
  "scripts": {
    "bundle-lang": "rm -rf lang && cp -r ../../lang/dist lang && echo '{\"type\":\"module\"}' > lang/package.json",
    "compile": "npm run bundle-lang && tsc -p ./ && tsc -p server/",
    "watch": "tsc -watch -p ./",
    "package": "npm run compile && vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "@types/vscode": "^1.80.0",
    "@types/ws": "^8.5.10",
    "@vscode/vsce": "^2.22.0",
    "typescript": "^5.3.0"
  }
}
