{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Attach to LSP Server",
      "type": "node",
      "request": "attach",
      "port": 6009,
      "restart": true,
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/out/server/**/*.js"],
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Launch Extension Host",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "outFiles": ["${workspaceFolder}/out/**/*.js"],
      "preLaunchTask": "${defaultBuildTask}"
    },
    {
      "name": "Extension Host + LSP Debug",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "outFiles": ["${workspaceFolder}/out/**/*.js"],
      "env": {
        "REAGENT_LSP_DEBUG": "true"
      },
      "preLaunchTask": "${defaultBuildTask}"
    }
  ],
  "compounds": [
    {
      "name": "Extension + LSP Server",
      "configurations": ["Extension Host + LSP Debug", "Attach to LSP Server"],
      "stopAll": true
    }
  ]
}
