{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Reagent",
  "scopeName": "source.reagent",
  "patterns": [
    { "include": "#comments" },
    { "include": "#messageDef" },
    { "include": "#roleDef" },
    { "include": "#protocol" },
    { "include": "#agentDef" },
    { "include": "#import" },
    { "include": "#messageWithProps" },
    { "include": "#messageBare" },
    { "include": "#agentZone" },
    { "include": "#reserved" },
    { "include": "#objects" },
    { "include": "#numbers" },
    { "include": "#strings" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.reagent",
          "match": "//.*$"
        },
        {
          "name": "comment.block.reagent",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.reagent",
          "match": "\\b(protocol|import|as|participants|initiator|input|alt|loop|par|wait|timeout|try|catch|else|and|agent|plays|init|on|message|role|extends|runs|invokes|spawns|scatter|gather|where)\\b"
        }
      ]
    },
    "langTag": {
      "patterns": [
        {
          "name": "storage.type.language.reagent",
          "match": "\\[(ts|js|py|kt|\\*)\\]"
        }
      ]
    },
    "messageDef": {
      "patterns": [
        {
          "name": "meta.definition.message.reagent",
          "begin": "^\\s*(message)\\s+([A-Za-z_][A-Za-z0-9_\\-\\.]*)\\s*(\\{)",
          "beginCaptures": {
            "1": { "name": "keyword.control.reagent" },
            "2": { "name": "entity.name.type.message.reagent" },
            "3": { "name": "punctuation.section.block.begin.reagent" }
          },
          "end": "^\\s*\\}",
          "endCaptures": {
            "0": { "name": "punctuation.section.block.end.reagent" }
          },
          "patterns": [
            { "include": "#comments" },
            { "include": "#messageFieldType" },
            {
              "name": "variable.other.field.reagent",
              "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\??"
            }
          ]
        }
      ]
    },
    "messageFieldType": {
      "patterns": [
        {
          "name": "support.type.reagent",
          "match": "\\b(string|number|boolean|any)\\b"
        },
        {
          "name": "punctuation.bracket.square.reagent",
          "match": "\\[\\]"
        }
      ]
    },
    "roleDef": {
      "patterns": [
        {
          "name": "meta.definition.role.reagent",
          "begin": "^\\s*(role)\\s+([A-Za-z_][A-Za-z0-9_\\-\\.]*)(?:\\s*(\\[(ts|js|py|kt|\\*)\\]))?(?:\\s+(extends)\\s+([A-Za-z_][A-Za-z0-9_\\-\\.]*))?\\s*(\\{)",
          "beginCaptures": {
            "1": { "name": "keyword.control.reagent" },
            "2": { "name": "entity.name.type.role.reagent" },
            "3": { "name": "storage.type.language.reagent" },
            "5": { "name": "keyword.control.reagent" },
            "6": { "name": "entity.name.type.role.reagent" },
            "7": { "name": "punctuation.section.block.begin.reagent" }
          },
          "end": "^\\}",
          "endCaptures": {
            "0": { "name": "punctuation.section.block.end.reagent" }
          },
          "patterns": [
            { "include": "#comments" },
            { "include": "#agentPlays" },
            { "include": "#roleInitBlock" },
            { "include": "#roleOnHandler" },
            { "include": "#keywords" },
            { "include": "#zoneKeywords" },
            { "include": "#strings" },
            { "include": "#numbers" }
          ]
        }
      ]
    },
    "roleInitBlock": {
      "patterns": [
        {
          "name": "meta.role.init.reagent",
          "begin": "\\b(init)\\s*(\\{)",
          "beginCaptures": {
            "1": { "name": "keyword.control.reagent" },
            "2": { "name": "punctuation.section.block.begin.reagent" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "punctuation.section.block.end.reagent" }
          },
          "patterns": [
            { "include": "#comments" },
            { "include": "#zoneKeywords" },
            { "include": "#strings" },
            { "include": "#numbers" }
          ]
        }
      ]
    },
    "roleOnHandler": {
      "patterns": [
        {
          "name": "meta.role.on-handler.reagent",
          "begin": "\\b(on)\\s+(protocolStarted|protocolCompleted|protocolFailed|protocolEvent)(\\()([A-Za-z_][A-Za-z0-9_\\-\\.]*)(\\))\\s*(\\{)",
          "beginCaptures": {
            "1": { "name": "keyword.control.reagent" },
            "2": { "name": "support.function.lifecycle-event.reagent" },
            "3": { "name": "punctuation.paren.open.reagent" },
            "4": { "name": "entity.name.type.protocol.reagent" },
            "5": { "name": "punctuation.paren.close.reagent" },
            "6": { "name": "punctuation.section.block.begin.reagent" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "punctuation.section.block.end.reagent" }
          },
          "patterns": [
            { "include": "#comments" },
            { "include": "#zoneKeywords" },
            { "include": "#strings" },
            { "include": "#numbers" }
          ]
        }
      ]
    },
    "protocol": {
      "patterns": [
        { "include": "#keywords" },
        {
          "name": "meta.definition.protocol.reagent",
          "begin": "^\\s*(protocol)\\s+([A-Za-z_][A-Za-z0-9_\\-\\.]*)\\s*(\\{)",
          "beginCaptures": {
            "1": { "name": "keyword.control.reagent" },
            "2": { "name": "entity.name.type.protocol.reagent" },
            "3": { "name": "punctuation.section.block.begin.reagent" }
          },
          "end": "^\\}",
          "endCaptures": {
            "0": { "name": "punctuation.section.block.end.reagent" }
          },
          "patterns": [
            { "include": "#comments" },
            { "include": "#keywords" },
            { "include": "#langTag" },
            { "include": "#messageWithProps" },
            { "include": "#messageBare" },
            { "include": "#agentZone" },
            { "include": "#reserved" },
            { "include": "#hookZone" },
            { "include": "#objects" },
            { "include": "#numbers" },
            { "include": "#strings" }
          ]
        }
      ]
    },
    "agentDef": {
      "patterns": [
        {
          "name": "meta.definition.agent.reagent",
          "match": "^\\s*(agent)\\s+([A-Za-z_][A-Za-z0-9_\\-\\.]*)(?:\\s*(\\[(ts|js|py|kt)\\]))?\\s+(runs)\\s+([A-Za-z_][A-Za-z0-9_\\-\\.]*)",
          "captures": {
            "1": { "name": "keyword.control.reagent" },
            "2": { "name": "entity.name.type.agent.reagent" },
            "3": { "name": "storage.type.language.reagent" },
            "5": { "name": "keyword.control.reagent" },
            "6": { "name": "entity.name.type.role.reagent" }
          }
        }
      ]
    },
    "agentPlays": {
      "patterns": [
        {
          "name": "meta.plays.reagent",
          "match": "\\b(plays)\\s+([A-Za-z_][A-Za-z0-9_\\-\\.]*)\\s+(as)\\s+([A-Za-z_][A-Za-z0-9_\\-\\.]*)",
          "captures": {
            "1": { "name": "keyword.control.reagent" },
            "2": { "name": "entity.name.type.protocol.reagent" },
            "3": { "name": "keyword.control.reagent" },
            "4": { "name": "variable.other.role.reagent" }
          }
        }
      ]
    },
    "import": {
      "patterns": [
        {
          "name": "meta.import.reagent",
          "match": "^\\s*(import)\\s+((\"[^\"]*\")|('[^']*'))(\\s+(as)\\s+([A-Za-z_][A-Za-z0-9_\\-\\.]*))?\\s*;?\\s*$",
          "captures": {
            "1": { "name": "keyword.control.reagent" },
            "3": { "name": "string.quoted.double.reagent" },
            "4": { "name": "string.quoted.single.reagent" },
            "6": { "name": "keyword.control.reagent" },
            "7": { "name": "entity.name.namespace.reagent" }
          }
        }
      ]
    },
    "arrow": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.reagent",
          "match": "(-->>|->>|-->|->)"
        }
      ]
    },
    "messageWithProps": {
      "patterns": [
        {
          "name": "meta.message.reagent",
          "begin": "^\\s*([A-Za-z_][A-Za-z0-9_\\-\\.]*)\\s*(-->>|->>|-->|->)\\s*([A-Za-z_][A-Za-z0-9_\\-\\.]*)\\s*:\\s*([^=\\n]+?)\\s*(=)\\s*(\\{)",
          "beginCaptures": {
            "1": { "name": "variable.other.role.reagent" },
            "2": { "name": "keyword.operator.arrow.reagent" },
            "3": { "name": "variable.other.role.reagent" },
            "4": { "name": "entity.name.function.message.reagent" },
            "5": { "name": "keyword.operator.assignment.reagent" },
            "6": { "name": "punctuation.section.block.begin.reagent" }
          },
          "end": "^\\s*\\}",
          "endCaptures": {
            "0": { "name": "punctuation.section.block.end.reagent" }
          },
          "patterns": [
            { "include": "#comments" },
            { "include": "#hookZone" },
            { "include": "#zoneKeywords" },
            { "include": "#objects" },
            { "include": "#strings" },
            { "include": "#numbers" }
          ]
        }
      ]
    },
    "messageBare": {
      "patterns": [
        {
          "name": "meta.message.bare.reagent",
          "match": "^\\s*([A-Za-z_][A-Za-z0-9_\\-\\.]*)\\s*(-->>|->>|-->|->)\\s*([A-Za-z_][A-Za-z0-9_\\-\\.]*)\\s*:\\s*([^=\\n{]+?)\\s*$",
          "captures": {
            "1": { "name": "variable.other.role.reagent" },
            "2": { "name": "keyword.operator.arrow.reagent" },
            "3": { "name": "variable.other.role.reagent" },
            "4": { "name": "entity.name.function.message.reagent" }
          }
        }
      ]
    },
    "hookZone": {
      "patterns": [
        {
          "name": "meta.hook.zone.reagent",
          "begin": "\\b(onSend|onReceive)\\s*(\\{)",
          "beginCaptures": {
            "1": { "name": "keyword.control.hook.reagent" },
            "2": { "name": "punctuation.section.block.begin.reagent" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "punctuation.section.block.end.reagent" }
          },
          "patterns": [
            { "include": "#comments" },
            { "include": "#zoneKeywords" },
            { "include": "#strings" },
            { "include": "#numbers" }
          ]
        }
      ]
    },
    "agentZone": {
      "patterns": [
        {
          "name": "meta.agent.zone.reagent",
          "begin": "^\\s*([A-Za-z_][A-Za-z0-9_\\-\\.]*)\\s*(\\{)\\s*$",
          "beginCaptures": {
            "1": { "name": "entity.name.type.agent.reagent" },
            "2": { "name": "punctuation.section.block.begin.reagent" }
          },
          "end": "^\\s*\\}\\s*$",
          "endCaptures": {
            "0": { "name": "punctuation.section.block.end.reagent" }
          },
          "patterns": [
            { "include": "#comments" },
            { "include": "#zoneKeywords" },
            { "include": "#strings" },
            { "include": "#numbers" }
          ]
        }
      ]
    },
    "zoneKeywords": {
      "patterns": [
        {
          "name": "support.function.reagent-runtime.reagent",
          "match": "\\breagent\\.(invoke|spawn|return|emit|break)\\b"
        },
        {
          "name": "variable.language.reagent-module.reagent",
          "match": "\\breagent\\b"
        },
        {
          "name": "variable.language.context.reagent",
          "match": "\\$ctx\\b"
        },
        {
          "name": "variable.language.flow.reagent",
          "match": "\\$flow\\b"
        },
        {
          "name": "variable.language.self.reagent",
          "match": "\\$self\\b"
        }
      ]
    },
    "reserved": {
      "patterns": [
        { "include": "#keywords" }
      ]
    },
    "objects": {
      "patterns": [
        {
          "name": "punctuation.section.block.begin.reagent",
          "match": "\\{"
        },
        {
          "name": "punctuation.section.block.end.reagent",
          "match": "\\}"
        },
        {
          "name": "punctuation.separator.comma.reagent",
          "match": ","
        },
        {
          "name": "punctuation.separator.key-value.reagent",
          "match": ":"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.reagent",
          "match": "\\b-?(0|[1-9][0-9]*)(\\.[0-9]+)?\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.reagent",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.reagent", "match": "\\\\." }
          ]
        },
        {
          "name": "string.quoted.single.reagent",
          "begin": "'",
          "end": "'",
          "patterns": [
            { "name": "constant.character.escape.reagent", "match": "\\\\." }
          ]
        }
      ]
    }
  }
}
